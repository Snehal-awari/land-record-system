# Google Gemini API Key for Multimodal Document Extraction
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Demo Mode toggle: When True, or if GEMINI_API_KEY is unset, the system uses high-fidelity pre-extracted sample data
DEMO_MODE=True

# Database URL (SQLite used by default; easily swappable with PostgreSQL)
DATABASE_URL=sqlite:///./land_records.db

# Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
